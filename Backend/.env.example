# Backend - Mentora (Render)
# Copia este archivo a .env y completa los valores, o pégalo directo
# en Render con "Add from .env".

# MongoDB Atlas. DB_HOST es la URI del cluster SIN usuario/contraseña:
# ac-xxxx-shard-00-00.mongodb.net:27017,ac-xxxx-shard-00-01...,ac-xxxx-shard-00-02.../?ssl=true&replicaSet=...&authSource=admin&appName=...
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=Mentora_db
# Opcional: opciones de conexión (default ya apunta a Atlas)
# DB_OPTIONS=ssl=true&replicaSet=...&authSource=admin&appName=Cluster0
# Alternativa: definir MONGO_URI completo y las variables DB_* quedan ignoradas
# MONGO_URI=

API_VERSION=v1
IP_SERVER=localhost
JWT_SECRET=
JWT_EXPIRATION=8h

# CORS: dominios permitidos separados por coma (incluye tu dominio de Vercel)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://tu-frontend.vercel.app

# Cloudinary (https://console.cloudinary.com/settings/api-keys)
# Si dejas CLOUDINARY_CLOUD_NAME vacío, los uploads usan disco local (solo dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puerto (Render lo asigna automáticamente)
PORT=3977
